{
  "name": "@vyredo/event-journal",
  "version": "0.1.0",
  "description": "An event-sourced journal on SQLite: streams, versioned events, deciders and projections into typed tables.",
  "license": "MIT",
  "author": "vyredo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyredo/event-journal.git"
  },
  "keywords": [
    "event-sourcing",
    "journal",
    "sqlite",
    "drizzle",
    "projections",
    "decider"
  ],
  "exports": {
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "default": "./dist/shared/*.js"
    },
    "./node/*": {
      "types": "./dist/node/*.d.ts",
      "default": "./dist/node/*.js"
    },
    "./node/schema.sql": "./dist/node/schema.sql"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@vyredo/typed-result": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vyredo/typed-result": "^0.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
